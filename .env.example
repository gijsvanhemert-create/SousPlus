# --- Database (PostgreSQL, EU-regio i.v.m. AVG) ---
# Hosted EU Postgres (Neon/Supabase). Vul je eigen connection string in.
#
# Supabase: gebruik de CONNECTION POOLER-host (de directe db.<ref>.supabase.co is
# IPv6-only). Pooler-username = postgres.<project-ref>, host = aws-0-<regio>.pooler.supabase.com.
# Laat sslmode WEG uit de URL: pg behandelt 'require' als 'verify-full' en weigert
# dan Supabase's self-signed chain. TLS wordt in code geregeld (zie src/server/db.ts).
#   Voorbeeld Supabase: postgresql://postgres.<ref>:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#   Voorbeeld Neon    : postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/sousplus?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/sousplus?schema=public"

# --- Auth.js (NextAuth v5) ---
# Genereer met: npx auth secret   (of: openssl rand -base64 32)
AUTH_SECRET="changeme-genereer-een-sterke-secret"

# In productie (next start) en achter een proxy vertrouwt Auth.js de host niet
# automatisch. Zet dit op true wanneer je niet op Vercel draait (ook nodig voor
# de Playwright-e2e, die tegen de productie-build draait).
# AUTH_TRUST_HOST="true"

# --- LLM / Intelligent Router (server-side ONLY) ---
# Leeg laten = mock-adapter (de app draait dan volledig zonder echte API-calls).
# Vul je echte sleutel in om de Anthropic-adapter te activeren.
ANTHROPIC_API_KEY=""

# Modelconfig (model-agnostisch; namen in config, niet hardcoded).
# Tier 1 = volume/goedkoop (OCR-extractie, classificatie); Tier 2 = advies/tool-use.
LLM_TIER1_MODEL="claude-haiku-4-5-20251001"
LLM_TIER2_MODEL="claude-sonnet-4-6"

# Optioneel — router-tuning (defaults tussen haakjes).
# LLM_MAX_TOKENS="1500"
# LLM_RATE_LIMIT_PER_MIN="30"        # AI-verzoeken per minuut per locatie
# LLM_TIER1_CACHE_TTL_MS="300000"    # TTL Tier 1 response-cache (5 min)

# --- HACCP-compliance ---
# Wettelijke bewaarplicht voor registraties in jaren (NL: doorgaans 2).
# HACCP_RETENTION_YEARS="2"

# --- E2e (Playwright) ---
# Zet op 1 om de automatische database-reseed vóór de e2e-run over te slaan.
# E2E_SKIP_SEED="1"
